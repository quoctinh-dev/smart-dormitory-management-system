erDiagram
    %% MODULE 2: SERVICES & SECURITY (DỊCH VỤ VÀ AN NINH IoT)
    
    %% THỰC THỂ THAM CHIẾU (REFERENCE ENTITIES) TỪ MODULE CORE
    Student {
        string ref_id PK "Reference"
    }
    Room {
        string ref_id PK "Reference"
    }
    Building {
        string ref_id PK "Reference"
    }
