        string ref_id PK "Reference"
    }
    UserAccount {
        string ref_id PK "Reference"
    }

    %% QUAN HỆ DỊCH VỤ & HÓA ĐƠN
    StudentHousingAssignment ||--o{ StayExtension : "Gia hạn (1-N)"
