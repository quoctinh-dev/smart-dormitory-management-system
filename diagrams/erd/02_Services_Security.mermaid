    StudentHousingAssignment ||--o{ Bill : "Phát sinh (1-N)"
    Bill ||--o| Payment : "Thanh toán (1-1)"
    
    Student ||--o{ CurfewRequest : "Xin về trễ (1-N)"
    Student ||--o{ MaintenanceRequest : "Yêu cầu bảo trì (1-N)"
    Room ||--o{ MaintenanceRequest : "Thuộc phòng (1-N)"
